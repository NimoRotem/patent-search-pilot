.pytest_cache/

# incremental ingest runtime artifacts (regenerable)
data/incremental.lock
data/incremental_state.json

# serving hardening: Flask session signing key + LLM spend meter (never commit)
.secret_key
data/run_budget.json

# federated search response cache (regenerable, and can be large)
data/federation_cache/

# OPS weekly byte budget + translation cache (regenerable runtime state)
data/ops_budget.json
data/translations/
data/finish_embed.*
*.bak-uiredesign-*
.env.bak-*

# public scope statement: last successful corpus scan, re-read at start-up (regenerable)
data/corpus_facts.json

# field text backfill progress (regenerable runtime state)
data/enrich_field_state.json
data/logs/

# benchmark runs are regenerable artefacts (eval/benchmark.py --run --tag N)
eval/benchmark_results/

# Timestamped in-place backups taken before a live patch. Never artefacts.
*.bak-*

# Niche corpus workstream. The extraction cache is a 2 GB copy of live tables (ops/niche_extract.py
# rebuilds it in about 4 minutes) and a manifest release is 1 to 2 GB of NDJSON. Both are build
# artefacts at a stable path, never repository content. docs/niche_manifest_contract.md says where.
data/niche_cache/
data/manifests/

#  THE OBSERVATION DOCKET IS PRIVATE AND THIS REPOSITORY IS PUBLIC.
#  data/observations/ holds one named third party's filings annotated with what our counsel
#  thinks, what was declined and what we have filed, plus the filing packages themselves,
#  including one that has not been filed yet and whose window is still open. Publishing it would
#  hand a competitor our whole position against them. It has never been committed; this is what
#  keeps a single `git add -A` in a deployed tree from being the first time. 11,194 files under
#  data/ ARE tracked, so that command is a normal thing to run here.
data/observations/
