{"detail": {"pub": "CN-111943013-B", "mongo_key": "CN111943013B", "title": "\u4e00\u79cd\u65e0\u7ebf\u771f\u7a7a\u5438\u76d8\u540a\u5177", "abstract": "\u672c\u53d1\u660e\u63d0\u4f9b\u4e86\u4e00\u79cd\u65e0\u7ebf\u771f\u7a7a\u5438\u76d8\u540a\u5177\u3002\u672c\u53d1\u660e\u5305\u62ec\u540a\u5177\u5916\u58f3\u3001\u63d0\u7269\u5438\u76d8\u3001\u62bd\u771f\u7a7a\u88c5\u7f6e\u3001\u4f9b\u7535\u7535\u6e90\uff0c\u6240\u8ff0\u62bd\u771f\u7a7a\u88c5\u7f6e\u7528\u4e8e\u5bf9\u63d0\u7269\u5438\u76d8\u5185\u90e8\u8fdb\u884c\u62bd\u6c14\uff0c\u5176\u7279\u5f81\u662f\uff1a\u6240\u8ff0\u540a\u5177\u5916\u58f3\u4e0a\u5f00\u8bbe\u6709\u5b89\u88c5\u53e3\uff0c\u6240\u8ff0\u4f9b\u7535\u7535\u6e90\u5305\u62ec\u88c5\u6709\u84c4\u7535\u6c60\u7684\u7535\u6c60\u76d2\uff0c\u6240\u8ff0\u7535\u6c60\u76d2\u5361\u63a5\u4e8e\u6240\u8ff0\u5b89\u88c5\u53e3\u5185\uff0c\u6240\u8ff0\u7535\u6c60\u76d2\u5185\u7684\u84c4\u7535\u6c60\u7535\u8fde\u63a5\u4e8e\u6240\u8ff0\u62bd\u771f\u7a7a\u88c5\u7f6e\u3002\u57fa\u4e8e\u7535\u6c60\u76d2\u4e0e\u540a\u5177\u5916\u58f3\u4e4b\u95f4\u91c7\u7528\u53ef\u62c6\u5378\u7ed3\u6784\uff0c\u53ef\u4e8b\u5148\u5c06\u591a\u4e2a\u5145\u6ee1\u7535\u7684\u7535\u6c60\u76d2\uff0c\u5c06\u5176\u4e2d\u4e00\u4e2a\u7535\u6c60\u76d2\u63d2\u5165\u5230\u540a\u5177\u5916\u58f3\u7684\u5b89\u88c5\u53e3\u5185\uff0c\u6b63\u5e38\u5de5\u4f5c\u4e00\u6bb5\u65f6\u95f4\u4e4b\u540e\uff0c\u518d\u5c06\u5df2\u4f7f\u7528\u4e00\u6bb5\u65f6\u95f4\u4e4b\u540e\u7684\u7535\u6c60\u76d2\u62c6\u5378\u4e0b\u6765\uff0c\u6362\u4e0a\u65b0\u7684\u7535\u6c60\u76d2\uff0c\u65e0\u9700\u8fdb\u884c\u4f20\u7edf\u7684\u505c\u673a\u5145\u7535\u64cd\u4f5c\uff0c\u4f7f\u7528\u4fbf\u6377\u6027\u9ad8\u3002", "assignees": ["\u6d59\u6c5f\u73a5\u8000\u8d77\u91cd\u673a\u68b0\u6709\u9650\u516c\u53f8"], "inventors": [], "country": "CN", "publication_date": "2021-02-09", "lang": null, "classifications": [], "claims": null, "description": null, "figures": [], "n_figures": 0, "pdf_url": null, "status": null}, "ts": 1787728007.7913616}