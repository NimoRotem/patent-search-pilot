{"detail": {"pub": "KR-20190050972-A", "mongo_key": "KR20190050972A", "title": "\ub0b4\ubd80 \ud38c\ud504 \uae30\uad6c\ub97c \uac16\ub294 \uc9c4\uacf5 \ubc00\ubd09\uac00\ub2a5\ud55c \uc6a9\uae30", "abstract": "\uc6a9\uae30 \ubc0f \ub69c\uaed1\uc5d0 \uc758\ud574 \ud615\uc131\ub418\ub294 \uae30\ubc00\ud615 \uacf5\ub3d9\uc744 \uc9c4\uacf5 \ubc00\ubd09\uc2dc\ud0a4\uae30 \uc704\ud55c \ud38c\ud504 \uae30\uad6c\ub85c\uc11c, \ud38c\ud504 \uae30\uad6c\ub294: \ubcf4\uc5b4\u2500\uc774 \ubcf4\uc5b4\ub294, \uae30\ubc00\ud615 \uacf5\ub3d9\uc73c\ub85c\ubd80\ud130\uc758 \uacf5\uae30\uac00 \ubcf4\uc5b4\uc5d0 \uc9c4\uc785\ud558\ub294 \uac83\uc744 \ud5c8\uc6a9\ud558\uace0 \uadf8\ub9ac\uace0 \ubcf4\uc5b4 \ub0b4\uce21\uc758 \uacf5\uae30\uac00 \uae30\ubc00\ud615 \uacf5\ub3d9\uc73c\ub85c \ubcf5\uadc0\ud558\ub294 \uac83\uc744 \ucc28\ub2e8\ud558\ub294 \uc81c1\uc758 \uc77c\ubc29\ud5a5 \uc2dc\uc77c, \ubc0f \ubcf4\uc5b4 \ub0b4\uce21\uc758 \uacf5\uae30\uac00 \uae30\ubc00\ud615 \uacf5\ub3d9\uc73c\ub85c \ubcf5\uadc0\ud558\uc9c0 \uc54a\uace0 \ubcf4\uc5b4\ub97c \ub5a0\ub098\ub294 \uac83\uc744 \ud5c8\uc6a9\ud558\uace0 \uadf8\ub9ac\uace0 \ubcf4\uc5b4 \uc678\uce21\uc5d0 \uc788\ub294 \uacf5\uae30\uac00 \ubcf4\uc5b4\uc5d0 \uc9c4\uc785\ud558\ub294 \uac83\uc744 \ucc28\ub2e8\ud558\ub294 \uc81c2\uc758 \uc77c\ubc29\ud5a5 \uc2dc\uc77c\uc744 \uac00\uc9d0\u2500, \ubcf4\uc5b4 \ub0b4\uce21\uc5d0 \ubc30\uce58\ub418\ub294 \ud53c\uc2a4\ud1a4, \ubc0f \ubcf4\uc5b4, \uc81c1 \ubc0f \uc81c2\uc758 \uc77c\ubc29\ud5a5 \uc2dc\uc77c\ub4e4, \uadf8\ub9ac\uace0 \ud53c\uc2a4\ud1a4\uc5d0 \uc758\ud574 \uc5d0\uc6cc\uc2f8\uc774\ub294 \uacf5\uae30\uc758 \ucc54\ubc84\ub97c \ud3ec\ud568\ud558\uba70, \uc5ec\uae30\uc11c \uc81c1 \ubc29\ud5a5\uc73c\ub85c\uc758 \ud53c\uc2a4\ud1a4\uc758 \uad6c\ub3d9\uc740 \uacf5\uae30\uac00 \uae30\ubc00\ud615 \uacf5\ub3d9\uc744 \uc9c4\uacf5\ubc30\uae30\ud558\uace0 \uc81c1\uc758 \uc77c\ubc29\ud5a5 \uc2dc\uc77c\uc744 \ud1b5\ud574 \ucc54\ubc84\uc5d0 \uc9c4\uc785\ud558\ub294 \uac83\uc744 \uc720\ubc1c\uc2dc\ud0a4\uba70, \uadf8\ub9ac\uace0 \uc5ec\uae30\uc11c \uc81c2 \ubc29\ud5a5\uc73c\ub85c\uc758 \ud53c\uc2a4\ud1a4\uc758 \uad6c\ub3d9\uc740 \uacf5\uae30\uac00 \uc81c2\uc758 \uc77c\ubc29\ud5a5 \uc2dc\uc77c\uc744 \ud1b5\ud574 \ucc54\ubc84\uc5d0\uc11c \ub098\uc624\ub294 \uac83\uc744 \uc720\ubc1c\uc2dc\ud0a8\ub2e4.", "assignees": ["\uc5d0\uc774\uce58\ube44\uc5d8 \ud640\ub529\uc2a4 \uc5d8\uc5d8\uc528"], "inventors": ["Cosgarea Andrew D."], "country": "KR", "publication_date": "2019-05-14", "lang": null, "classifications": [], "claims": null, "description": null, "figures": [], "n_figures": 0, "pdf_url": null, "status": null}, "ts": 1787727891.693905}